{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openrgd:periph:authorization:policy:v0.1-candidate",
  "title": "PERIPH policy offline candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "authority_id",
    "consent_authority_id",
    "revision",
    "audience",
    "clock_domain",
    "issued_ms",
    "expires_ms",
    "grants",
    "revoked_grant_ids",
    "grants_authority",
    "actuation_enabled"
  ],
  "properties": {
    "schema_version": {
      "const": "openrgd.periph.authz-policy.v0.1-candidate"
    },
    "authority_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._:-]{0,99}$"
    },
    "consent_authority_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._:-]{0,99}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "audience": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._:-]{0,99}$"
    },
    "clock_domain": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._:-]{0,99}$"
    },
    "issued_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expires_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "grants": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "grant_id",
          "principal",
          "mode",
          "scope",
          "capability",
          "audience",
          "valid_from_ms",
          "expires_ms"
        ],
        "properties": {
          "grant_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._:-]{0,99}$"
          },
          "principal": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "issuer_id",
              "subject_id",
              "session_id",
              "client_id"
            ],
            "properties": {
              "issuer_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9._:-]{0,99}$"
              },
              "subject_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9._:-]{0,99}$"
              },
              "session_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9._:-]{0,99}$"
              },
              "client_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9._:-]{0,99}$"
              }
            }
          },
          "mode": {
            "enum": [
              "direct",
              "delegated"
            ]
          },
          "scope": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "host_id",
              "robot_id",
              "peripheral_id"
            ],
            "properties": {
              "host_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,79}$"
              },
              "robot_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,79}$"
              },
              "peripheral_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,79}$"
              }
            }
          },
          "capability": {
            "enum": [
              "peripheral.status.read",
              "acquisition.start",
              "acquisition.stop"
            ]
          },
          "audience": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._:-]{0,99}$"
          },
          "valid_from_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "expires_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      }
    },
    "revoked_grant_ids": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9._:-]{0,99}$"
      }
    },
    "grants_authority": {
      "const": false
    },
    "actuation_enabled": {
      "const": false
    }
  }
}
