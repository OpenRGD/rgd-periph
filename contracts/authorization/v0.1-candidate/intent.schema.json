{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openrgd:periph:authorization:intent:v0.1-candidate",
  "title": "PERIPH intent offline candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "grant_id",
    "audience",
    "scope",
    "capability",
    "policy_revision",
    "expected_status_revision",
    "clock_domain",
    "issued_ms",
    "expires_ms",
    "grants_authority",
    "actuation_enabled"
  ],
  "properties": {
    "schema_version": {
      "const": "openrgd.periph.authz-intent.v0.1-candidate"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "grant_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._:-]{0,99}$"
    },
    "audience": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._:-]{0,99}$"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host_id",
        "robot_id",
        "peripheral_id"
      ],
      "properties": {
        "host_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,79}$"
        },
        "robot_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,79}$"
        },
        "peripheral_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,79}$"
        }
      }
    },
    "capability": {
      "enum": [
        "peripheral.status.read",
        "acquisition.start",
        "acquisition.stop"
      ]
    },
    "policy_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expected_status_revision": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "clock_domain": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._:-]{0,99}$"
    },
    "issued_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expires_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "grants_authority": {
      "const": false
    },
    "actuation_enabled": {
      "const": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "capability": {
            "const": "peripheral.status.read"
          }
        }
      },
      "then": {
        "properties": {
          "expected_status_revision": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "expected_status_revision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      }
    }
  ]
}
